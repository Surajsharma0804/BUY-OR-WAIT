# Copy to .env (or export directly) to enable the optional LLM/VLM
# extraction fallback described in README.md. Never commit a real key.
#
# With no key set, the system runs fully deterministically end-to-end and
# evaluation/usage_report.md reports $0.00 -- see README.md, "Dependencies".
ANTHROPIC_API_KEY=

# Optional overrides (default: claude-haiku-4-5-20251001 for both -- a
# right-sized model for short, schema-constrained extraction calls, not a
# frontier model, since no financial decision is ever made by the model):
# AGENT_LLM_TEXT_MODEL=claude-haiku-4-5-20251001
# AGENT_LLM_VISION_MODEL=claude-haiku-4-5-20251001
